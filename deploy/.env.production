# ---------------------------------------------------------------------------
# projectkaya.lk - production settings
#
# Upload this to the application directory on the host and rename it to
# exactly `.env` (with the leading dot, no extension). It belongs NEXT TO
# `artisan`, one level ABOVE `public/` - never inside public_html, where a
# browser could fetch it and read your database password.
#
# In cPanel File Manager, turn on Settings -> Show Hidden Files or you will
# not see it after uploading.
#
# This file is NOT the one on your PC. api/.env stays local.
# ---------------------------------------------------------------------------

APP_NAME="Project Kaya"
APP_ENV=production
APP_KEY=base64:b8JvN97mkDnruPXMqQ4QrCwIlaBgN1L6s75NDmiuUhE=

# Never true on a public site: an exception page prints the database password,
# file paths and parts of the request straight to whoever triggered it.
APP_DEBUG=false

APP_URL=https://projectkaya.lk
APP_TIMEZONE=Asia/Colombo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# `debug` on a live site fills the disk and writes request details into a file
# that outlives the request.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ----------------------------------------------------------------- database
#
# On cPanel this is always `localhost` and port 3306 - the database runs on the
# same machine as PHP. 127.0.0.1:3307 is your WAMP MariaDB at home and means
# nothing here.
#
# Both names carry your cPanel account prefix. Fill in the password you set in
# MySQL(r) Databases, and make sure the user is attached to the database with
# ALL PRIVILEGES.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=villaimp_project_kaya
DB_USERNAME=villaimp_project_kaya
DB_PASSWORD=

# ------------------------------------------------------------------ session
#
# Sessions and cache live in the database because shared hosting gives no
# guarantee that a file cache survives, and no Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_LIFETIME_DAYS=30
SESSION_IDLE_TIMEOUT_MINUTES=720
SESSION_REQUIRE_REQUEST_HEADER=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# Shared hosting usually serves PHP directly, so only the loopback is trusted.
# If you later put Cloudflare or any other proxy in front, add its addresses
# here - otherwise every visitor appears to come from the proxy, which breaks
# rate limiting and writes the wrong IP into the audit log.
TRUSTED_PROXIES=127.0.0.1,::1

# -------------------------------------------------------------------- mail
#
# `log` writes messages to storage/logs instead of sending them, so nothing is
# delivered until you point this at a real mailbox. Create one in cPanel ->
# Email Accounts and fill in the four lines below, or leave it as `log` until
# you are ready.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@projectkaya.lk"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_MAILER=smtp
# MAIL_HOST=mail.projectkaya.lk
# MAIL_PORT=465
# MAIL_USERNAME=no-reply@projectkaya.lk
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=ssl

# The panel is served from this same domain at /admin, so there is no second
# origin and no CORS to configure.
FRONTEND_URL=https://projectkaya.lk

# Which hosts may hold a session cookie. Left unset this falls back to a list
# that still includes localhost, which is harmless but untidy on a live site.
# Add every hostname the panel is actually opened on - if you reach it at
# www.projectkaya.lk and that is not listed, sign-in appears to work and then
# every request comes back 401.
SANCTUM_STATEFUL_DOMAINS=projectkaya.lk,www.projectkaya.lk

# HSTS tells browsers to refuse plain HTTP for this domain for a year, and
# they remember it whether or not the header is still being sent. Only leave
# this on once HTTPS is working on every hostname, including www - it is
# deliberately hard to undo.
SECURITY_HSTS_MAX_AGE=31536000

# -------------------------------------------------------------- housekeeping
#
# cPanel does not put mysqldump on PHP's PATH, so the nightly backup would
# fail with "command not found". /usr/bin/mysqldump is the usual location;
# check it in cPanel -> Terminal with `which mysqldump` if backups stay empty.
BACKUP_MYSQLDUMP_PATH=/usr/bin/mysqldump
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=30

FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=log

# --------------------------------------------------------------- biometrics
#
# The reader cannot be reached from shared hosting, so pull sync is off and the
# device pushes to us instead. See docs/BIOMETRIC-SETUP.md.
BIOMETRIC_SYNC_ENABLED=false
BIOMETRIC_SYNC_INTERVAL_MINUTES=1
BIOMETRIC_HTTP_TIMEOUT=15

# The shared secret the reader sends with every pushed scan. Put this exact
# value into the terminal's HTTP listening configuration. Left empty, the push
# endpoint rejects everything rather than accepting anything - it fails closed.
BIOMETRIC_PUSH_TOKEN=2c465d039eaf4adcde2825626ff59dccc14a75a7f2064dcf
