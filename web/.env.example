# Where the Laravel API is running.
#
# The dev server proxies /api and /storage here, so the browser stays on one
# origin and CORS behaves in development exactly as it will behind a reverse
# proxy in production.
#
# Change this if `php artisan serve` had to use a different port — 8000 is a
# popular one, and another application listening on it makes every /api call
# return that application's 404.
API_PROXY_TARGET=http://127.0.0.1:8000

# The port this dev server listens on.
WEB_PORT=5173
