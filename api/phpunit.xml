<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Tests run against MySQL/MariaDB, not SQLite in memory.

            The SRS specifies MySQL/MariaDB, and the parts of this system most
            worth testing lean on it: DATE_ADD in the membership expiry sweep,
            MONTH() in the monthly report, and the unique index on
            biometric_event_logs.event_hash that makes attendance ingestion
            idempotent. On SQLite those either fail outright or pass while the
            production database would behave differently - which is worse.

            Create the database once:
              CREATE DATABASE gms_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="gms_test"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3307"/>
        <env name="DB_URL" value=""/>
        <env name="APP_TIMEZONE" value="Asia/Colombo"/>
        <env name="BIOMETRIC_PUSH_TOKEN" value="test-push-token"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
