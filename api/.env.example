APP_NAME="Gym Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Colombo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Session security (SRS 26) -------------------------------------------
# The session token is delivered in an httpOnly cookie, so it cannot be read
# by script and a cross-site scripting hole cannot walk off with it.
# See docs/SECURITY.md before changing anything here.

# How long a session lasts however active it is.
SESSION_LIFETIME_DAYS=30

# How long a session survives unused. This is the one that matters: the front
# desk terminal sits in a public room and gets walked away from. 0 disables it.
# 720 = 12 hours, which covers a full shift without carrying overnight.
SESSION_IDLE_TIMEOUT_MINUTES=720

# Hops whose X-Forwarded-* headers may be believed, comma separated.
#
# Behind a Cloudflare tunnel or a reverse proxy on the same machine, leave
# this at loopback: that is where the agent connects from, and it is the only
# hop that should be able to state the client's real address. The address it
# states is recorded on every signed health form as evidence, decides whether
# the session cookie gets its Secure flag, and is what the public form is rate
# limited by.
#
# Use '*' only when the application cannot be reached except through the
# proxy. On a server that is also open on the local network, '*' lets anyone
# on that network forge the client IP.
TRUSTED_PROXIES=127.0.0.1,::1

# Requires a custom header on cookie-authenticated writes, which a cross-site
# form cannot send. Leave on unless an integration genuinely needs cookies.
SESSION_REQUIRE_REQUEST_HEADER=true

# Normally decided by whether the request arrived over HTTPS, which is correct
# both behind a TLS-terminating proxy and in local development. Set it only to
# override that. A Secure cookie over plain HTTP is dropped by the browser with
# no error, which looks exactly like "signing in does nothing".
# SESSION_FORCE_SECURE_COOKIE=true

# Two years, and only ever sent over HTTPS. Set to 0 to stop sending it.
SECURITY_HSTS_MAX_AGE=31536000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@gms.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend (CORS / Sanctum) ---
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# --- Gym / business settings ---
GYM_CURRENCY=LKR
GYM_INVOICE_PREFIX=INV
GYM_RECEIPT_PREFIX=RCP
GYM_MEMBER_NO_PREFIX=GM

# --- Attendance behaviour ---
# Reject scans when membership is not ACTIVE (SRS 10). If false, the scan is
# recorded but flagged so reception can follow up.
ATTENDANCE_REJECT_INVALID_MEMBERSHIP=true
# Minutes within which an identical scan is treated as a duplicate (SRS 9.6)
ATTENDANCE_DUPLICATE_WINDOW_MINUTES=2
# Minimum minutes between a CHECK_IN and its CHECK_OUT in automatic mode
ATTENDANCE_MIN_SESSION_MINUTES=5
# Hour (0-23) at which an open check-in is auto-closed by the day roll-over job
ATTENDANCE_AUTO_CLOSE_HOUR=23

# --- Biometric integration service (SRS 13) ---
BIOMETRIC_SYNC_ENABLED=true
BIOMETRIC_SYNC_INTERVAL_MINUTES=1
BIOMETRIC_HTTP_TIMEOUT=15
# Shared secret the on-device ISAPI "HTTP Host / Listening" push must present
BIOMETRIC_PUSH_TOKEN=

# --- Membership expiry notifications ---
MEMBERSHIP_EXPIRY_REMINDER_DAYS=7,3,1

# --- Backup (SRS 30) ---
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=30
BACKUP_MYSQLDUMP_PATH="C:/wamp64/bin/mariadb/mariadb11.5.2/bin/mysqldump.exe"
